[Unit]
Description=BHM gateway - Daly BMS (RS485) to MQTT over TLS
Wants=network-online.target time-sync.target
After=network-online.target time-sync.target

[Service]
Type=simple
Environment=PYTHONPATH=/opt/bhm-gateway/lib PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 -m bhm_gateway --config /etc/bhm/bhm.toml
Restart=always
RestartSec=5

# Runs as an unprivileged throw-away user that may only open serial ports.
DynamicUser=yes
SupplementaryGroups=dialout
StateDirectory=bhm
# Secrets stay root:root 0600 in /etc/bhm; systemd hands a private copy to the
# service under $CREDENTIALS_DIRECTORY (referenced from bhm.toml).
LoadCredential=mqtt_password:/etc/bhm/mqtt_password
LoadCredential=client.key:/etc/bhm/certs/client.key

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
